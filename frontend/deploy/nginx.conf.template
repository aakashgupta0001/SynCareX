# SynCareX PWA + reverse proxy. Serves the built app same-origin with the
# API, which is what the SameSite=Strict session cookie requires.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # Basic hardening; TLS headers are the responsibility of the outer
    # reverse proxy / load balancer described in the deployment guide.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # The service worker and the app shell must revalidate on every load, or
    # a deployed update would never reach installed devices.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
    }

    # Hashed build assets are immutable.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # nginx resolves a literal proxy_pass host once at startup and caches it
    # forever. On hosts where the backend gets a new address when it restarts
    # (Fly machines, rolling deploys), that cached address goes stale and
    # every API call 502s until the frontend is restarted too. Putting the
    # upstream in a variable forces nginx to re-resolve it, which needs an
    # explicit resolver.
    resolver ${DNS_RESOLVER} valid=10s ipv6=on;
    set $backend_origin ${BACKEND_ORIGIN};
    proxy_ssl_server_name on;

    # API: keep the /api prefix (backend routes are /api/v1/...).
    location /api/ {
        # With a variable upstream nginx no longer appends the matched URI,
        # so $request_uri is passed explicitly.
        proxy_pass $backend_origin$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 32m;
    }

    # Backend health endpoint lives at the root, outside /api.
    location = /health {
        proxy_pass $backend_origin/health;
        proxy_set_header Host $host;
    }

    # SPA fallback: every unknown route serves the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
