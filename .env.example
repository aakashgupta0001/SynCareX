APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
DATABASE_URL=sqlite:///./syncarex.db
# For PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://syncarex:replace_with_a_local_password@localhost:5432/syncarex
POSTGRES_DB=syncarex
POSTGRES_USER=syncarex
POSTGRES_PASSWORD=replace_with_a_local_password
JWT_SECRET=replace_with_a_random_secret_before_running
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
SEED_ADMIN_EMAIL=admin@syncarex.example.com
SEED_ADMIN_PASSWORD=

# Offline engine
OFFLINE_GRACE_DAYS=7
MAX_DOCUMENT_BYTES=10485760
# Where uploaded clinical documents are written. Keep it outside the web root.
# DOCUMENT_STORAGE_DIR=./var/documents
SYNC_BATCH_LIMIT=50

# Local AI engine (optional; the clinical workflows never require it).
# Generated per run by ai_engine/run_local.ps1 - do not commit a value here.
SYNCAREX_AI_TOKEN=
SYNCAREX_AI_MODEL_DIR=
SYNCAREX_AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Absolute paths to the local binaries, when they are installed.
SYNCAREX_WHISPER_BIN=
SYNCAREX_TESSERACT_BIN=

# Production requires: APP_ENV=production, a unique JWT_SECRET (never the
# development default), COOKIE_SECURE=true, an explicit non-SQLite
# DATABASE_URL, and no SEED_ADMIN_PASSWORD. Startup fails otherwise.
